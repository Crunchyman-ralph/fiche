# Copy to .env and fill in. Never commit .env.

# Database
# POSTGRES_PORT is read by docker-compose.yml to bind the postgres container
# on a non-default host port (5432 often collides with other dev DBs).
# DATABASE_URL must point at the same port. Update both if you change one.
POSTGRES_PORT=5434
DATABASE_URL=postgres://fiche:fiche@localhost:5434/fiche

# Better Auth
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-base64
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog (analytics, sessions, errors, LLM observability)
# Leave blank in self-host to disable analytics entirely.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Public env for the web app (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Runtime
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
